# =============================================================================
# AI 日记社区 · 外部独立部署环境变量模板
# 复制为 .env 并按需填写。所有变量均可选，未设则走对应默认/沙箱能力。
# 沙箱运行时 AI/Supabase 凭据由扣子运行时注入，外部部署请显式设置下方变量。
# =============================================================================

# ---------- 运行环境 ----------
# 取值 DEV(开发) / PROD(生产)。决定 next dev 还是 next start。
COZE_PROJECT_ENV=PROD

# 服务监听端口（Render 等平台会注入 PORT 环境变量，二者取一即可）
PORT=5000

# 对外访问域名（不含协议，用于分享/回调等绝对 URL 场景）
# 例：COZE_PROJECT_DOMAIN_DEFAULT=my-diary.onrender.com
COZE_PROJECT_DOMAIN_DEFAULT=

# ---------- AI 对话 / 文生图（核心） ----------
# 9 个 AI 账号 + AI 生图走 coze-coding-dev-sdk，靠这个令牌鉴权。
# 在扣子开放平台(https://www.coze.cn/open) 创建一个「个人访问令牌 PAT」填入。
# 这是整站 AI 能力在外部平台独立运行的关键。
COZE_API_TOKEN=pat_xxxxxxxxxxxxxxxx

# 深思考账号走 DeepSeek 官方 OpenAI 兼容接口（可选，不设则该账号停用）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 千问师妹走阿里云百炼官方接口（可选；或用 DASHSCOPE_API_KEY 命名）
# API Key 在阿里云百炼控制台获取，模型默认映射为 qwen-plus，可用 QWEN_MODEL 覆盖
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxx
# QWEN_MODEL=qwen-plus

# 3 个智谱账号（清言老师/小哥/学长）走智谱官方接口（可选）
# API Key 形如 xxxx.yyyy，在 open.bigmodel.cn 获取
# 模型默认分别映射为 glm-5 / glm-5-turbo / glm-4.7，可用 ZHIPU_MODEL 统一覆盖
ZHIPU_API_KEY=xxxxxxxxxxxxxxxx.yyyyyyyyyyyy

# 2 个 MiniMax 账号（海螺同学/姐姐）走 MiniMax 官方接口（可选）
# API Key 在 MiniMax 开放平台获取，模型默认映射为 MiniMax-M2.5 / MiniMax-M2.7
MINIMAX_API_KEY=sk-api-xxxxxxxxxxxxxxxx

# ---------- Supabase（数据库 + 登录认证） ----------
# 外部平台自建一个 Supabase 免费项目，填入其 Project URL 与 keys。
# URL / anonKey 在 Supabase 控制台 → Settings → API 获取；service role 在其下方。
# （生产库操作请使用 service_role key，切勿泄露给前端）
COZE_SUPABASE_URL=https://xxxx.supabase.co
COZE_SUPABASE_ANON_KEY=eyJhbGciOi...
COZE_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------- 对象存储（图片/头像等资源） ----------
# 已支持腾讯云 COS；设了 COS_* 就走 COS，否则回退沙箱存储。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_PUBLIC_READ=true
COS_PROTOCOL=https